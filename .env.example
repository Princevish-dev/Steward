# ==============================================================================
# STEWARD AI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE PAYPAL SANDBOX INTEGRATION
# ------------------------------------------------------------------------------
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ------------------------------------------------------------------------------
# 2. DATABASE & NEON POSTGRESQL (SHA-256 LEDGER PERSISTENCE)
# ------------------------------------------------------------------------------
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# 3. AI AGENT REASONING ENGINE (GEMINI & ANTHROPIC)
# ------------------------------------------------------------------------------
USE_LLM=true
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
CHANNEL3_API_KEY=
CHANNEL3_API_URL=

# ------------------------------------------------------------------------------
# 4. HORIZONTALLY SCALABLE STATELESS AUTHENTICATION (HMAC-SHA256 COOKIES)
# ------------------------------------------------------------------------------
# Cryptographic secret for signing stateless session tokens (steward_session cookie)
# Enterprise horizontal scale: No centralized Redis or sticky sessions required.
SESSION_SECRET=steward-secure-session-hmac-key-min-32-chars
# NEXTAUTH_SECRET is supported as a 100% drop-in alias for NextAuth/Enterprise IdP compatibility
NEXTAUTH_SECRET=

# ------------------------------------------------------------------------------
# 5. SECURITY, ENCRYPTION & APP HOST
# ------------------------------------------------------------------------------
VAULT_ENC_KEY=
APP_BASE_URL=http://localhost:3000
